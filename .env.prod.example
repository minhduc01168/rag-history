# ==========================================
# ĐẠI VIỆT KIDS AI - PRODUCTION DEPLOYMENT ENV
# ==========================================

APP_NAME=Đại Việt Kids AI
APP_VERSION=1.0.0
DEBUG=false

# Database Config (Production Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_strong_password_here
POSTGRES_DB=daivietkids_db
DATABASE_URL=postgresql://postgres:generate_a_very_strong_password_here@postgres:5432/daivietkids_db

# ChromaDB & Embedding (Internal Docker Network)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
EMBEDDING_SERVICE_URL=http://embedding_service:8002/embed
EMBEDDING_MODEL_NAME=microsoft/harrier-oss-v1-0.6b
MAX_SEQ_LENGTH=512

# CORS Origins (Domain chính thức của website trên production)
ALLOWED_ORIGINS=["https://daivietkids.edu.vn","http://your-server-ip"]

# LLM API Keys (BẮT BUỘC ĐIỀN KEY THẬT)
GEMINI_API_KEY=your_production_gemini_api_key
GROQ_API_KEY=

# Auth Settings (Tạo chuỗi ngẫu nhiên bằng `openssl rand -hex 32`)
SECRET_KEY=generate_strong_secret_key_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
