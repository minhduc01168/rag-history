# ==========================================
# ĐẠI VIỆT KIDS AI - LOCAL DEVELOPMENT ENV
# ==========================================

APP_NAME=Đại Việt Kids API (Local Dev)
APP_VERSION=0.1.0
DEBUG=true

# Database Config (Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daivietkids_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=daivietkids_db

# ChromaDB Config
CHROMA_HOST=localhost
CHROMA_PORT=8001
EMBEDDING_SERVICE_URL=http://localhost:8002/embed

# CORS Origins (Allow Local Dev Servers)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM API Keys (Thay thế bằng key thật của bạn)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=

# Auth Settings
SECRET_KEY=daivietkids_dev_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
